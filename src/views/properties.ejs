<%- include('head', { title: 'Properties' }) -%>


<h1>Available Properties</h1>
<form method="get" class="filters">
    <div class="card">
        <label for="checkIn">Check-In</label>
        <input type="date" name="checkIn" id="checkIn" value="<%= checkIn || '' %>" min="<%= new Date().toISOString().split('T')[0] %>">
    </div>

    <div class="card">
        <label for="checkOut">Check-Out</label>
        <input type="date" name="checkOut" id="checkOut" value="<%= checkOut || '' %>" min="<%= new Date().toISOString().split('T')[0] %>">
    </div>

    <div class="card">
        <label for="minGuests">Guests</label>
        <input type="number" name="minGuests" id="minGuests" min="1" value="<%= minGuests || '' %>">
    </div>

    <div class="card">
        <label for="maxPrice">Max Price Per Night</label>
        <input type="number" name="maxPrice" id="maxPrice" min="0" step="0.01" value="<%= maxPrice || '' %>">
    </div>

    <label for="type">Type</label>
    <select name="type" id="type">
        <option value="">Any type</option>
        <option value="HOME_RENTAL" <%= type === 'HOME_RENTAL' ? 'selected' : '' %>>Home Rental </option>
        <option value="BNB" <%= type === 'BNB' ? 'selected' : '' %>>Bed & Breakfast</option>
        <option value="HOTEL" <%= type === 'HOTEL' ? 'selected' : '' %>>Hotel</option>
        <option value="HOSTEL" <%= type === 'HOSTEL' ? 'selected' : '' %>>Hostel</option>
    </select>

    <div class="card">
        <button type="submit">Search Availability</button>
        <a href="/properties">Clear</a>
    </div>
</form>
<% if (properties.length === 0) { %>
    <% if (checkIn && checkOut) { %>
        <p>No properties are available for those dates.</p>
    <% } else { %>
        <p>There aren't any listed properties yet!</p>
    <% } %>
<% } else { %>
    <% if (checkIn && checkOut) { %>
        <p>Showing properties available from <%= checkIn %> to <%= checkOut %>.</p>
    <% } %>
    <% properties.forEach(property => { %>
        <div class="card">
            <p>Property Name: <%= property.propertyName %></p>
            <div class="card">
                <p>Address: <%= property.streetAddress %> - <%= property.cap %>, <%= property.city %></p>
                <p>Province and Country: <%= property.province %>, <%= property.country %></p>
            </div>
            <div class="card">
                <p>Max Guests: <%= property.maxGuests %></p>
                <p>Base Price: €<%= property.price %></p>
            </div>
            <div class="card">
                <% if (property.ownerId !== userId) { %>
                    <a href="/properties/<%= property.id %>">See property details page and Book a stay at this property!</a>
                <% } %>
            </div>
        </div>
    <% }); %>
<% } %>


<%- include('foot') -%>