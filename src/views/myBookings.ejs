<%- include('head', { title: 'My Bookings' }) -%>

<h1>My Bookings</h1>
<a href="/properties" class="btn">Make a new Booking</a>

<% if (bookings.length === 0) { %>
    <p>You haven't made any bookings yet!</p>
<% } else { %>
    <% bookings.forEach(booking => { %>
        <div class="card">
            <h3><%= booking.property.propertyName %></h3>
            <p>
                <span class="status <%= booking.status.toLowerCase() %>"><%= booking.status %></span>
            </p>
            <p><%= booking.checkInDate.toLocaleDateString('it-IT') %> → <%= booking.checkOutDate.toLocaleDateString('it-IT') %></p>
            <p>Guests: <strong><%= booking.numberGuests %></strong> · Total: <strong>€<%= booking.bookingPrice %></strong></p>

            <% if (booking.status !== 'CANCELLED') { %>
                <div class="actions">
                    <form method="post" action="/bookings/<%= booking.id %>/cancel">
                        <button type="submit" class="danger">Cancel this booking</button>
                    </form>
                </div>
            <% } %>
        </div>
    <% }); %>
<% } %>

<%- include('foot') -%>