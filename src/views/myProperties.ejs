<%- include('head', { title: 'My Properties' }) -%>


<h1>My Properties</h1>
<a href="/properties/new" class="btn">Add New Property</a>
<% if (properties.length === 0) { %>
    <p>You haven't listed any properties yet!</p>
<%} else {%>
    <% properties.forEach(property => { %>
        <div class="card">
            <h3>Property Name: <%= property.propertyName %></h3>
            <% if (property.photoPath) { %>
                <img src="/uploads/<%= property.photoPath %>" alt="<%= property.propertyName %>" class="hero">
            <% } %>
            <p>Status: <span class="status"><%= property.isActive ? 'Published' : 'Draft' %></span></p>
            <p>Address: <%= property.streetAddress %> - <%= property.cap %>, <%= property.city %></p>
            <p>Province and Country: <%= property.province %>, <%= property.country %></p>

            <p>Max Guests: <%= property.maxGuests %></p>
            <p>Base Price: €<%= property.price %></p>

            <div class="actions">

                <a href="/properties/<%= property.id %>/edit" class="btn">Edit</a>

                <% if (property.isActive) { %>
                    <form method="post" action="/properties/<%= property.id %>/unpublish">
                        <button type="submit">Unpublish</button>
                    </form>
                <% } else { %>
                    <form method="post" action="/properties/<%= property.id %>/publish">
                        <button type="submit">Publish</button>
                    </form>
                <% } %>
                <form method="post" action="/properties/<%= property.id %>/delete">
                    <button type="submit" class="danger">Delete</button>
                </form>
            </div>
        </div>
    <% }); %>
<% } %>



<%- include('foot') -%>