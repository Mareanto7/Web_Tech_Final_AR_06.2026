<%- include('head', { title: 'New Booking Page' }) -%>

    <h1>New Booking Form</h1>
    <% if (error) { %>
        <p class="error"><%= error %></p>
    <% } %>
    <h2>Book <%= property.propertyName %></h2>
    <p>City: <%= property.city %></p>
    <p>Max guests: <%= property.maxGuests %></p>

    <form method="post" action="/properties/<%= property.id %>/book">
        <p>
            <label for="checkInDate">Check-in Date</label>
            <input type="date" name="checkInDate" min="<%= new Date().toISOString().split('T')[0] %>" id="checkInDate" required>
        </p>
        <p>
            <label for="checkOutDate">Check-out Date</label>
            <input type="date" name="checkOutDate" min="<%= new Date().toISOString().split('T')[0] %>" id="checkOutDate" required>
        </p>
        <p>
            <label for="numberGuests">Number of Guests: </label>
            <input type="number" name="numberGuests" min="1" max="<%= property.maxGuests %>" id="numberGuests" required>
        </p>
        <p>Price per night: €<%= property.price %></p>
        <p>Estimated Total: €<span id="total">-</span></p>
        <p>
            <select name="channel" id="channel" required>
                <option value="">-- How did you find us? --</option>
                    <option value="GOOGLE">Google</option>
                    <option value="INSTAGRAM">Instagram</option>
                    <option value="FACEBOOK">Facebook</option>
                    <option value="TIKTOK">TikTok</option>
                    <option value="WORD_OF_MOUTH">Word of Mouth</option>
                    <option value="BOOKING">Booking.com</option>
                    <option value="AIRBNB">AirBnB</option>
                    <option value="OTHER">Other</option>
            </select>
        </p>
        <p>
            <input type="submit" value="Book a Stay">
        </p>
    </form>

    <script>
        const PRICE = <%= property.price %>;
        const MS_PER_DAY = 1000 * 60 * 60* 24;
        const inEl = document.getElementById('checkInDate');
        const outEl = document.getElementById('checkOutDate');
        const totalEl = document.getElementById('total');

        function updateTotal() {
            const start = new Date(inEl.value);
            const end = new Date(outEl.value);
            if (isNaN(start) || isNaN(end) || end <= start){
                totalEl.textContent = '-';
                return;
            }
        const nights = (end - start) / MS_PER_DAY;
        totalEl.textContent = (nights * PRICE).toFixed(2);
        }
        inEl.addEventListener('change', updateTotal);
        outEl.addEventListener('change', updateTotal);
    </script>

    <%- include('foot') -%>

