<%- include('head', { title: 'Property Details' }) -%>

<h1><%= property.propertyName %></h1>

<% if (property.photoPath) { %>
    <img src="/uploads/<%= property.photoPath %>" alt="<%= property.propertyName %>" class="hero">
<% } %>
<%# show property details - view only %>
<div class="card">
    <p>Address: <%= property.streetAddress %> - <%= property.cap %>, <%= property.city %></p>
    <p>Province and Country: <%= property.province %>, <%= property.country %></p>
    <p>Maximum Number of Guests: <%= property.maxGuests %></p>
    <p>Price per night: €<%= property.price %></p>

    <%# book or edit - action for different user %>
    <% if (property.ownerId !== userId) { %>
        <a href="/properties/<%= property.id %>/book" class="btn">Book this property</a>
    <% } else { %>
        <a href="/properties/<%= property.id %>/edit" class="btn">Edit your property</a>
    <% } %>
</div>

<%# property availability fields - view only %>
<h2>Availability this month</h2>
<div class="card">
    <div class="calendar">
        <% const today = new Date();
           const year = today.getUTCFullYear();
           const month = today.getUTCMonth();
           const firstDay = new Date(Date.UTC(year, month, 1));
           const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
           // JS weeks start Sunday; shift so Monday is column 1
           const offset = (firstDay.getUTCDay() + 6) % 7;
        %>

        <div class="dow">Mon</div><div class="dow">Tue</div><div class="dow">Wed</div>
        <div class="dow">Thu</div><div class="dow">Fri</div><div class="dow">Sat</div><div class="dow">Sun</div>

        <% for (let i = 0; i < offset; i++) { %>
            <div></div>
        <% } %>

        <% for (let day = 1; day <= daysInMonth; day++) {
             const iso = new Date(Date.UTC(year, month, day)).toISOString().split('T')[0];
             const isBooked = occupied.includes(iso);
        %>
            <div class="day <%= isBooked ? 'booked' : 'free' %>"><%= day %></div>
        <% } %>
    </div>

    <p class="muted" style="text-align: center;">
        <span class="legend booked"></span> Booked &nbsp;
        <span class="legend free"></span> Available
    </p>
</div>